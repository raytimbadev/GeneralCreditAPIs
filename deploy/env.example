# Copiar para /etc/bci-api/env  (chmod 640, dono root:bci)
# Gerar a chave:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=SUBSTITUIR_POR_CHAVE_ALEATORIA
DJANGO_SETTINGS_MODULE=config.settings
SQLITE_PATH=/var/lib/bci-api/db.sqlite3
BCI_AGRAVAMENTO=0
# Documentacao em /api/bci/docs, aberta sem token. 0 desliga.
BCI_DOCS=1
