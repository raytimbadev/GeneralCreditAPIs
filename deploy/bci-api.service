[Unit]
Description=API BCI - simulacao Capital Decrescente
After=network.target

[Service]
User=bci
WorkingDirectory=/opt/apps/bci_simulacao
EnvironmentFile=/etc/bci-api/env
ExecStart=/opt/apps/bci_simulacao/.venv/bin/gunicorn --workers 3 --bind 0.0.0.0:8000 config.wsgi
Restart=on-failure

[Install]
WantedBy=multi-user.target
